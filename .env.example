APP_NAME=AGI Platform
APP_VERSION=9.0.0
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=5001
WORKERS=5
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/agi_platform
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=40
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=memory_vectors
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=30
JWT_SECRET_KEY=your-super-secret-key-64-characters-minimum-xxxxxxxxxxxxxxxxxxxxxxxx
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=30
CORS_ORIGINS=*
RATE_LIMIT_FREE=3
RATE_LIMIT_PRO=100
RATE_LIMIT_BUSINESS=1000
LOG_LEVEL=INFO
LOG_FORMAT=json
EMBEDDING_MODEL=all-MiniLM-L6-v2
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_RAG=true
ENABLE_MEMORY=true
ENABLE_TOOLS=true
ENABLE_VOICE=true
ENABLE_RERANKING=true
