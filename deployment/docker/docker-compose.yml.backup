services:
  db:
    image: postgres:15-alpine
    container_name: agi_db
    environment:
      POSTGRES_USER: agi
      POSTGRES_PASSWORD: postgres
      POSTGRES_DB: agi
    volumes:
      - pg_data:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U agi -d agi"]
      interval: 5s
      timeout: 5s
      retries: 12

  redis:
    image: redis:7-alpine
    container_name: agi_redis
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 5s
      retries: 10

  qdrant:
    image: qdrant/qdrant:v1.9.2
    container_name: agi_qdrant
    ports:
      - "6333:6333"
    environment:
      QDRANT__STORAGE__STORAGE_TYPE: disk
      QDRANT__STORAGE__SNAPSHOTS_PATH: /qdrant/storage
      QDRANT__TELEMETRY__ENABLED: "false"
    volumes:
      - qdrant_data:/qdrant/storage

  backend:
    build: .
    container_name: agi_backend
    command: sh -c "alembic upgrade head && uvicorn backend.main:app --host 0.0.0.0 --port 8000"
    environment:
      DATABASE_URL: postgresql://agi:postgres@db:5432/agi
      REDIS_URL: redis://redis:6379/0
      QDRANT_URL: http://qdrant:6333
      JWT_SECRET: supersecretkey_change_in_production_1234567890abcdef
    depends_on:
      db:
        condition: service_healthy
    ports:
      - "8000:8000"
    volumes:
      - ./backend:/app/backend
      - ./alembic:/app/alembic
      - ./alembic.ini:/app/alembic.ini

volumes:
  pg_data:
  qdrant_data: