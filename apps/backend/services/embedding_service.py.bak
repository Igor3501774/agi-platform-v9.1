import os
from typing import List
import asyncio
import logging
import httpx

logger = logging.getLogger(__name__)

class EmbeddingService:
    def __init__(self):
        self.model_name = os.getenv("EMBEDDING_MODEL", "bge-small-en-v1.5")
        self.api_key = os.getenv("DEEPSEEK_API_KEY")
        self.base_url = "https://api.deepseek.com/v1/embeddings"
        self._cache = {}
        logger.info(f"EmbeddingService initialized with model: {self.model_name}")

    async def encode(self, texts: List[str]) -> List[List[float]]:
        """Получение эмбеддингов через DeepSeek API с кешированием"""
        if not texts:
            return []

        # Очищаем тексты
        texts = [t.strip() for t in texts if t and t.strip()]
        if not texts:
            return []

        # Проверка кеша
        uncached_texts = []
        cached_results = []
        for text in texts:
            if text in self._cache:
                cached_results.append(self._cache[text])
            else:
                uncached_texts.append(text)

        if uncached_texts:
            try:
                async with httpx.AsyncClient(timeout=30.0) as client:
                    response = await client.post(
                        self.base_url,
                        headers={
                            "Authorization": f"Bearer {self.api_key}",
                            "Content-Type": "application/json"
                        },
                        json={
                            "model": self.model_name,
                            "input": uncached_texts
                        }
                    )
                    response.raise_for_status()
                    data = response.json()

                    vectors = []
                    for item in data.get("data", []):
                        vector = item.get("embedding", [])
                        if vector:
                            vectors.append(vector)
                            # Кешируем
                            idx = len(cached_results) + len(vectors) - 1
                            if idx < len(texts):
                                self._cache[texts[idx]] = vector

                    # Объединяем результаты
                    result = []
                    cache_idx = 0
                    vector_idx = 0
                    for text in texts:
                        if text in self._cache:
                            result.append(self._cache[text])
                        else:
                            if vector_idx < len(vectors):
                                result.append(vectors[vector_idx])
                                vector_idx += 1
                            else:
                                result.append([0.0] * 768)

                    logger.debug(f"Encoded {len(result)} texts with model {self.model_name}")
                    return result

            except httpx.TimeoutException:
                logger.error("DeepSeek API timeout, using fallback")
                return self._get_fallback_embeddings(len(texts))
            except Exception as e:
                logger.error(f"Embedding error: {e}, using fallback")
                return self._get_fallback_embeddings(len(texts))

        return cached_results

    async def encode_single(self, text: str) -> List[float]:
        """Получение эмбеддинга для одного текста"""
        result = await self.encode([text])
        return result[0] if result else [0.0] * 768

    def _get_fallback_embeddings(self, count: int) -> List[List[float]]:
        """Фолбэк-эмбеддинги (для отладки, если DeepSeek недоступен)"""
        import hashlib
        vectors = []
        for i in range(count):
            seed = f"fallback_{i}_{i * 7}"
            digest = hashlib.sha256(seed.encode("utf-8")).digest()
            vector = [(byte / 255.0) * 2.0 - 1.0 for byte in digest[:32]]
            # Дополняем до 768
            vector = vector * 24  # 32 * 24 = 768
            vector = vector[:768]
            vectors.append(vector)
        return vectors