import logging, httpx, os
from typing import Dict, Any
from backend.services.agent_registry import get_registry

logger = logging.getLogger(__name__)

class AgentService:
    def __init__(self):
        self.api_key = os.getenv("DEEPSEEK_API_KEY")
        self.model = os.getenv("DEEPSEEK_MODEL", "deepseek-chat")
        self.base_url = "https://api.deepseek.com/v1/chat/completions"
    
    async def process_message(self, agent_id: str, message: str) -> Dict[str, Any]:
        registry = get_registry()
        await registry.ensure_loaded()
        agent = registry.get_agent(agent_id)
        if not agent:
            return {"error": f"Agent {agent_id} not found"}
        
        prompt = agent.get("prompt_template", "")
        full_prompt = f"{prompt}\n\nВопрос пользователя: {message}" if prompt else message
        
        try:
            async with httpx.AsyncClient(timeout=30.0) as client:
                response = await client.post(
                    self.base_url,
                    headers={"Authorization": f"Bearer {self.api_key}", "Content-Type": "application/json"},
                    json={
                        "model": self.model,
                        "messages": [{"role": "system", "content": "Ты полезный AI ассистент."},
                                     {"role": "user", "content": full_prompt}],
                        "temperature": 0.7, "max_tokens": 2048
                    }
                )
                if response.status_code == 200:
                    data = response.json()
                    return {
                        "agent_id": agent_id,
                        "agent_name": agent.get("name"),
                        "response": data["choices"][0]["message"]["content"],
                        "tokens_used": data["usage"]["total_tokens"]
                    }
                else:
                    return {"agent_id": agent_id, "agent_name": agent.get("name"),
                            "response": f"Ошибка API: {response.status_code}", "error": "API error"}
        except Exception as e:
            logger.error(f"LLM error: {e}")
            return {"agent_id": agent_id, "agent_name": agent.get("name"),
                    "response": f"Ошибка: {str(e)}", "error": str(e)}