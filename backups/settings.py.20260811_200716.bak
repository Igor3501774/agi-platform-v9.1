from pydantic_settings import BaseSettings, SettingsConfigDict
from typing import Optional, List
from pathlib import Path
from pydantic import validator, Field

class Settings(BaseSettings):
    model_config = SettingsConfigDict(env_file=".env", env_file_encoding="utf-8", case_sensitive=False, extra="ignore")
    
    APP_NAME: str = "AGI Platform"
    APP_VERSION: str = "9.0.0"
    APP_ENV: str = "development"
    DEBUG: bool = True
    HOST: str = "0.0.0.0"
    PORT: int = 5001
    WORKERS: int = 5
    
    DATABASE_URL: str = "postgresql+asyncpg://user:pass@localhost:5432/agi_platform"
    DATABASE_POOL_SIZE: int = 20
    DATABASE_MAX_OVERFLOW: int = 40
    
    REDIS_URL: str = "redis://localhost:6379/0"
    REDIS_CACHE_TTL: int = 3600
    CELERY_BROKER_URL: str = "redis://localhost:6379/1"
    CELERY_RESULT_BACKEND: str = "redis://localhost:6379/2"
    
    QDRANT_URL: str = "http://localhost:6333"
    QDRANT_COLLECTION: str = "memory_vectors"
    
    DEEPSEEK_API_KEY: str = ""
    DEEPSEEK_MODEL: str = "deepseek-chat"
    DEEPSEEK_TIMEOUT: int = 30
    
    JWT_SECRET_KEY: str = "your-super-secret-key-64-characters-minimum"
    JWT_ALGORITHM: str = "HS256"
    JWT_ACCESS_EXPIRE_MINUTES: int = 15
    JWT_REFRESH_EXPIRE_DAYS: int = 30
    
    @validator('JWT_SECRET_KEY')
    def validate_jwt_secret(cls, v: str) -> str:
        if len(v) < 64:
            raise ValueError("JWT_SECRET_KEY must be at least 64 characters")
        return v
    
    CORS_ORIGINS: List[str] = ["*"]
    RATE_LIMIT_FREE: int = 3
    RATE_LIMIT_PRO: int = 100
    RATE_LIMIT_BUSINESS: int = 1000
    
    LOG_LEVEL: str = "INFO"
    LOG_FORMAT: str = "json"
    STORAGE_PATH: Path = Path("./storage")
    EMBEDDING_MODEL: str = "all-MiniLM-L6-v2"
    CROSS_ENCODER_MODEL: str = "cross-encoder/ms-marco-MiniLM-L-6-v2"
    
    ENABLE_RAG: bool = True
    ENABLE_MEMORY: bool = True
    ENABLE_TOOLS: bool = True
    ENABLE_VOICE: bool = True
    ENABLE_RERANKING: bool = True

settings = Settings()

